generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                   @id @default(cuid())
  username                       String                   @unique
  passwordHash                   String
  role                           String                   @default("user")
  email                          String?                  @unique
  createdAt                      DateTime                 @default(now())
  reinigungErlaubt               Boolean                  @default(false)
  reinigungMaxMinuten            Int                      @default(15)
  reinigungMaxProTag             Int                      @default(0)
  // Tägliche Öffnungs-Fenster für Reinigung als JSON-String, z.B. [{"start":"19:00","end":"20:00"}]
  // (CH-Lokalzeit). SQLite/Prisma 5 kennt kein Json → TEXT; parseReinigungsFenster deserialisiert.
  reinigungsFenster              String?
  // Automatische Kontrollen: pro Tag zufällig X Kontrollen, wobei X selbst zufällig aus
  // [PerDayMin, PerDayMax] gewürfelt wird. Frist darf nicht ins Schlaf-Fenster (RuheVon–RuheBis,
  // CH-Lokalzeit) fallen; Erfüllungsdauer zufällig in [FristVon, FristBis] Min.
  autoKontrolleAktiv             Boolean                  @default(false)
  autoKontrollePerDayMin         Int                      @default(0) // Min-Anzahl/Tag
  autoKontrollePerDayMax         Int                      @default(0) // Max-Anzahl/Tag (< Min → als Min behandelt)
  autoKontrolleRuheVon           String                   @default("22:00")
  autoKontrolleRuheBis           String                   @default("06:00")
  autoKontrolleFristVon          Int                      @default(15)
  autoKontrolleFristBis          Int                      @default(60)
  // Optionales festes AUSLÖSE-Fenster ("HH:MM", "" = aus): sind beide gesetzt und Von<Bis, fallen die
  // Auslösungen (wirksamAb) in dieses Fenster statt gleichmässig übers Wach-Fenster. Die Frist läuft
  // danach normal und darf übers Fensterende hinaus, wird aber am nächsten Schlaf-Beginn gekappt.
  autoKontrolleFensterVon        String                   @default("")
  autoKontrolleFensterBis        String                   @default("")
  // true = Auto-Kontrollen nur auslösen, während eine aktive Sperrzeit (SPERRZEIT) läuft. Die Slots
  // werden weiter für jeden Tag geplant; wird eine bei Fälligkeit ohne aktive Sperrzeit angetroffen,
  // zieht der Poller sie zurück (kein Nachholen — dieselbe Behandlung wie eine Auslösung bei offenem KG).
  autoKontrolleNurBeiSperre      Boolean                  @default(false)
  // Der Tag, für den der Auto-Kontroll-Plan zuletzt gewürfelt wurde: Instant der Sub-lokalen
  // Mitternacht (`midnightInTZ`). Hält auch einen Wurf auf NULL Kontrollen fest, der keine Zeile
  // hinterlässt — warum das die Spalte rechtfertigt, steht bei `markDayPlanned`.
  autoInspectionPlannedFor       DateTime?
  // Kontroll-Eskalation (Stufe 1: Mahnung, Stufe 2: automatisch als abgelegt markieren). Beide
  // Stufen sind unabhängig voneinander schaltbar und standardmässig AUS (Opt-in, kein
  // Verhaltenswechsel für Bestandsnutzer). Delay-Werte in Minuten; Stufe 2 zählt ab dem Zeitpunkt
  // der Mahnung (KontrollAnforderung.benachrichtigtReminderAt), nicht ab der Deadline.
  inspectionReminderEnabled      Boolean                  @default(false)
  inspectionReminderDelayMinutes Int                      @default(5)
  inspectionAutoMarkEnabled      Boolean                  @default(false)
  inspectionAutoMarkDelayMinutes Int                      @default(60)
  mobileDesktopUpload            Boolean                  @default(false)
  // IANA-Zeitzone des Nutzers (z.B. "America/New_York"). Governiert Anzeige, Eingabe-Defaults und
  // die Wanduhr-Fenster (Reinigung/Schlaf) für DIESEN Nutzer. Default "Europe/Zurich" = bisheriges
  // Verhalten für alle Bestandsnutzer (keine sichtbare Änderung).
  timezone                       String                   @default("Europe/Zurich")
  // Startseite nach Login (pro User): "auto" = rollen-/sub-abhängig (Keyholder→Übersicht bzw. einziger
  // Sub direkt, sonst eigener Tracker), "overview" = Keyholder-Übersicht, "dashboard" = eigener Tracker.
  startPage                      String                   @default("auto")
  // Keyholder/Admin-Präferenz: eigene Karte in der Keyholder-Übersicht ausblenden (für Keyholder,
  // die keinen eigenen Tracker nutzen). Nur relevant, wenn die eigene Karte dort überhaupt erscheint.
  hideOwnTracker                 Boolean                  @default(false)
  // Per-user UI + notification language ("de" | "en"). Drives the app locale AND the language of
  // all e-mails / push sent to this user (rendered server-side from this field, not the browser cookie).
  locale                         String                   @default("de")
  // Pro-User anpassbare Auswahllisten als JSON-Array [{code,label?}] (TEXT). null = eingebaute
  // Standardliste (Bestandsnutzer unverändert). Öffnungsgründe enthalten IMMER den geschützten
  // Built-in "REINIGUNG" (Code fix, nur Label umbenennbar). Siehe reasonsService.ts.
  orgasmusArtenConfig            String?
  oeffnenGruendeConfig           String?
  // Abweichungen vom Standard-Dashboard (JSON, je Oberfläche `{hidden, order}`). NULL = Standard,
  // also exakt die vorgegebene Reihenfolge mit allen Blöcken. Bewusst Abweichungen statt der
  // Blockliste: sonst bliebe jeder künftig hinzukommende Block bei Bestandsnutzern unsichtbar.
  dashboardLayout                String?
  // Welche Umstellung dieser Nutzer zuletzt quittiert hat, als Versionsnummer ("6.0.0").
  //
  // Eine VERSION und kein Boolean: derselbe Merker trägt damit auch den nächsten
  // Umstellungs-Hinweis, statt dass jeder eine eigene Spalte bekommt. Und am `User` und nicht in
  // `localStorage`, weil der Hinweis einmal pro PERSON gelesen werden soll — nicht einmal pro
  // Gerät. Genau das war der Fehler, den #88 beschrieb: eine Anzeige-Entscheidung im
  // Gerätespeicher läuft zwischen Handy und Rechner auseinander.
  noticeSeenVersion              String?
  // Free-text keyholder rules the human admin sets for the MCP AI keyholder (soft guidance, read-only to the agent).
  mcpKeyholderInstructions       String?
  // ── Gewichtstracking (docs/gewicht-konzept.md) ────────────────────────────────────────────────
  // Schalter der Keyholderin je Sub. Aus = Erfassung, Anzeigen und MCP-Schreiben verschwinden, die
  // Daten bleiben. Dazu der Instanz-Schalter `ENABLE_WEIGHT_TRACKING` (constants.ts).
  weightTrackingEnabled          Boolean                  @default(false)
  // AKTUELLE Körpergrösse. Jede Änderung wird zusätzlich in `HeightChange` protokolliert; gerechnet
  // wird heute überall mit diesem aktuellen Wert.
  heightCm                       Int?
  // Anzeige-Präferenz DESSEN, DER SCHAUT ("metric" | "imperial") — keine Eigenschaft der Daten:
  // eine Keyholderin darf Pfund sehen, während ihr Sub in Kilogramm einträgt.
  unitSystem                     String                   @default("metric")
  // Das Zielgewicht. Beide Seiten dürfen eines setzen, und BEIDE bleiben sichtbar; wirksam ist das
  // der Keyholderin, solange sie eines führt (siehe `effectiveTarget` in `weight.ts`). Nimmt sie es
  // zurück, gilt wieder seines.
  //
  // `...SetAt` ist kein Protokoll — wer wann geändert hat, steht im Aktions-Log. Es beantwortet die
  // Frage, ab WELCHEM Gewicht gerechnet wird: der Fortschritt („von 100 auf 90, 38 % geschafft")
  // misst gegen die Messung, die beim Setzen des Ziels galt. Ohne den Zeitpunkt wäre der Startwert
  // die jeweils älteste Messung überhaupt — und ein neu gesetztes Ziel begänne rückwirkend.
  targetWeightKg                 Float?
  targetWeightSetAt              DateTime?
  targetWeightKeyholderKg        Float?
  targetWeightKeyholderSetAt     DateTime?
  // Wiege-Fenster als JSON-String, gesetzt von der Keyholderin (Sub-Lokalzeit):
  // [{"start":"05:00","durationMin":180,"days":127,"remind":true}] — `days` ist eine Wochentags-
  // Bitmaske (Mo=1 … So=64, 127 = täglich, siehe `weekdays.ts`), `remind` schickt zum Fensterbeginn
  // eine Erinnerung. NULL/[] = keine Fensterpflicht, jede Uhrzeit gilt. Alt-Fenster im Format
  // {"start","end"} werden weiter gelesen und in Start + Dauer übersetzt.
  //
  // Bewusst NICHT historisiert: ob eine Messung im Fenster lag, entscheidet der Erfassungs-Zeitpunkt
  // und steht danach auf der Zeile (`WeightEntry.inWindow`). Es gibt also nichts, was später nach
  // einer alten Fassung neu beurteilt werden müsste — anders als bei den Reinigungsfenstern, deren
  // Verletzung das Strafbuch live ableitet.
  weighingWindows                String?
  /// Für welches Fenster zuletzt an die Wiege-Meldung erinnert wurde: `<YYYY-MM-DD>#<HH:MM>` in der
  /// Zone des Trägers. Verhindert, dass der Minuten-Poller dieselbe Erinnerung wiederholt — und
  /// erlaubt es ihm zugleich, sie nach einem Neustart NACHZUHOLEN, solange das Fenster noch läuft.
  /// Eine eigene Tabelle wäre eine Zeile je Tag und Träger, die nach dem Tag niemanden mehr angeht.
  weightReminderMark             String?
  entries                        Entry[]
  notificationPrefs              NotificationPreference[]
  vorgaben                       TrainingVorgabe[]
  passwordResetTokens            PasswordResetToken[]
  kontrollAnforderungen          KontrollAnforderung[]
  verschlussAnforderungen        VerschlussAnforderung[]
  orgasmusAnforderungen          OrgasmusAnforderung[]
  tasks                          Task[]
  devices                        Device[]
  strafeRecords                  StrafeRecord[]
  adminPasswordChanges           AdminPasswordChange[]    @relation("AdminPasswordChangeSub")
  adminRelationships             AdminUserRelationship[]  @relation("AdminRelationships")
  userRelationships              AdminUserRelationship[]  @relation("UserRelationships")
  pushSubscriptions              PushSubscription[]
  nativePushTokens               NativePushToken[]
  passkeys                       Passkey[]
  deviceCategories               DeviceCategory[]
  boxEvents                      BoxEvent[]
  boxStatuses                    BoxStatus[]
  keyholderNotes                 KeyholderNote[]
  keyholderActionLogs            KeyholderActionLog[]
  healthHolds                    HealthHold[]
  recurringContexts              RecurringContext[]
  appointments                   Appointment[]
  receivedMessages               Message[]
  messageReads                   MessageRead[]
  manualOffenses                 ManualOffense[]
  offenseRuleChanges             OffenseRuleChange[]
  cleaningRuleChanges            CleaningRuleChange[]
  timezoneChanges                TimezoneChange[]
  weightEntries                  WeightEntry[]
  heightChanges                  HeightChange[]
  weightReleases                 WeightRelease[]
}

/// Freigabe-Vorgabe: das Gewicht öffnet das nächste Orgasmus-Fenster (docs/gewicht-freigabe-konzept.md).
///
/// Die Keyholderin stellt eine Schwelle, gegen die das MITTEL der letzten Tage geprüft wird — nicht
/// der Tageswert. Ein einzelnes Wiegen schwankt um ein bis zwei Kilo (Salz, Mahlzeit, Tageszeit),
/// und eine Freigabe daran zu hängen hiesse, Kochsalz über den Orgasmus entscheiden zu lassen.
///
/// Eigene Tabelle und kein Feld an `OrgasmusAnforderung`: die Vorgabe steht über viele Tage, die
/// Anforderung ist ein Fenster mit festem Anfang und Ende. Eine Bedingung in die Anforderung zu
/// legen hiesse, deren `beginntAt` dynamisch zu machen — und daran hängen Poller, Erfüllung,
/// Rückzug und die Vergehens-Ableitung.
///
/// Sie ist VERBRAUCHT, sobald sie ausgelöst hat (`releasedAt`); die nächste stellt die Keyholderin.
/// Eine sich selbst fortschreibende Regel würde aus dem letzten Gewicht das nächste Ziel ableiten —
/// und diese Aussage gehört ihr, nicht dem Rechenkern.
model WeightRelease {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Schwelle, gegen die das Mittel geprüft wird. IMMER metrisch, wie `WeightEntry.weightKg`.
  thresholdKg    Float
  /// "below" = das Mittel muss darunter liegen · "above" = darüber (Zunehmen als Vorgabe).
  direction      String   @default("below")
  /// Breite des Mittels in KALENDER-Tagen des Trägers — nicht „die letzten N Messungen".
  averageDays    Int      @default(3)
  /// Wie viele zählende Messungen im Fenster liegen müssen, damit das Mittel gilt. Bei einer
  /// einzigen wäre das „Mittel" dieser eine Wert — also genau das Tagesrauschen zurück, dessen
  /// Vermeidung der Grund für das Mittel war.
  minMeasurements Int     @default(2)
  /// Optionaler Tagesanstieg der Schwelle; 0 = konstant. Mit ihm kommt die Vorgabe dem Träger
  /// entgegen, statt auf einer Zahl zu beharren.
  stepKg         Float    @default(0)

  /// Mindestlaufzeit: davor öffnet nichts, egal was die Waage sagt.
  notBeforeAt    DateTime
  /// Wie lange das erzeugte Fenster offen steht.
  windowHours    Int      @default(24)
  /// Wird an die erzeugte Anforderung durchgereicht: Öffnen zum Orgasmus erlaubt?
  openingAllowed Boolean  @default(false)
  /// Freitext, der in der erzeugten Anforderung landet.
  message        String?

  /// Username des Keyholders, der sie gestellt hat, bzw. `ai` über den MCP — dieselbe Spalte und
  /// dieselbe Begründung wie `OrgasmusAnforderung.createdBy`.
  createdBy      String?
  createdAt      DateTime @default(now())
  /// Bezugspunkt des Tagesanstiegs: der Tag, an dem `thresholdKg` unverändert gilt.
  armedAt        DateTime
  /// Gesetzt, sobald sie ausgelöst hat — damit ist sie verbraucht.
  releasedAt     DateTime?
  /// Die erzeugte Anforderung, zur Nachvollziehbarkeit.
  releasedRequestId String?
  withdrawnAt    DateTime?

  @@index([userId, releasedAt, withdrawnAt])
}

/// Ein von Hand notiertes Vergehen — das einzige, das nicht aus Einträgen ABGELEITET wird.
///
/// Alle übrigen Arten entstehen live aus dem Bestand (eine Öffnung während einer Sperrzeit IST das
/// Vergehen). Was der Keyholder ausserhalb der App beobachtet — eine gebrochene Absprache, eine
/// Unhöflichkeit, irgendetwas ohne Eintrag — hat keine Quelle, aus der es abgeleitet werden könnte.
/// Es braucht darum eine eigene Zeile. Vorbild ist `AdminPasswordChange`: festgeschrieben statt
/// abgeleitet, aus demselben Grund.
///
/// Zurückgezogen wird über `withdrawnAt`, nicht gelöscht: ein Fehleintrag verschwindet aus dem
/// Strafbuch, bleibt aber nachlesbar. Nur solange NICHT geurteilt wurde (`StrafeRecord.refId` =
/// diese id): sonst bliebe eine Strafaufgabe beim Sub stehen, während ihr Anlass aus dem Strafbuch
/// fällt. Der Weg zurück führt über die Rücknahme des Urteils — siehe `withdrawManualOffense`.
model ManualOffense {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Wann es passiert ist (nicht wann es notiert wurde) — danach richtet sich die Einordnung im
  /// Strafbuch UND welche Regel-Fassung gilt (siehe OffenseRuleChange).
  occurredAt  DateTime
  title       String
  description String?
  /// Username des Keyholders/Admins, der notiert hat, bzw. die KI-Kennung `ai` für den Weg über den
  /// MCP. Wie `StrafeRecord.judgedBy` ein Audit-Feld — mit dem Unterschied, dass hier auch ein echter
  /// NAME stehen kann und nicht nur ein Kürzel. LEER heisst „kein Autor festgehalten" (nur auf dem
  /// unerreichbaren Ausweichpfad der Route); daraus wird die Meldung an den Träger wieder eine
  /// System-Zeile, siehe `senderFromAuthor`.
  ///
  /// UNVERÄNDERLICH: dieses Modul kennt nur Anlegen und Zurückziehen (`manualOffenseService.ts`),
  /// keinen Umschreib-Pfad. Darauf beruht, dass die Meldung den Namen KOPIEREN darf — siehe
  /// `Message.senderName`.
  createdBy   String
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([userId, occurredAt])
}

/// Eine Änderung an den Reinigungs-Regeln eines Subs — append-only, gleiche Bauart wie
/// OffenseRuleChange: die für den Zeitpunkt t geltende Fassung ist die jüngste Zeile mit
/// `effectiveFrom <= t`, sonst der heutige Stand der vier User-Spalten.
///
/// Warum eine Historie und nicht bloss die Spalten am User: Das Strafbuch leitet die Vergehen LIVE
/// aus den Einträgen ab und las dabei den HEUTIGEN Wert. Senkte die Keyholderin das Tageskontingent
/// von 2 auf 1, wurde damit rückwirkend jede zurückliegende zweite Reinigungsöffnung zum Vergehen —
/// für einen Tag, an dem die App dem Träger „1 von 2" angezeigt und ihn nicht gewarnt hatte
/// (gemeldet 19.08.2026). Dasselbe gilt über das Strafbuch hinaus: die Sessions selbst zerfallen an
/// ihren Pausen, wenn „Reinigung erlaubt" oder die Höchstdauer nachträglich enger wird — mitsamt
/// Rekorden, Statistik und den Aufgaben, die durchgehendes Tragen verlangen.
///
/// Die Spalten am User bleiben der aktuelle Stand — Durchsetzung, Oberfläche und MCP lesen weiter
/// dort. Diese Tabelle beantwortet allein die Frage der Vergangenheit: was galt DAMALS.
///
/// Die erste Änderung eines Subs schreibt ZWEI Zeilen: den Ausgangsstand mit `effectiveFrom` = Epoch
/// (`changedBy` = null, denn den hat niemand gesetzt) und die neue Fassung ab jetzt. Ohne diese
/// Grundzeile fiele die Zeit vor der ersten Änderung auf die User-Spalten zurück — also auf den
/// neuen Wert, und damit genau in den Fehler zurück, den die Tabelle behebt.
/// Historie der Zeitzone eines Trägers — dieselbe Bauart wie `CleaningRuleChange` und aus demselben
/// Grund: die Zone entscheidet mit, ob eine Reinigungsöffnung im erlaubten Fenster lag und an welchem
/// Kalendertag sie auf das Tageskontingent zählte. Ohne Historie beurteilte eine Umstellung die
/// ganze Vergangenheit neu — und weil der Träger sie selbst setzen darf, wäre das eine
/// selbstbediente Neubeurteilung.
///
/// Die frühere Begründung, die Zone sei "eine Eigenschaft des Subs, keine Regel der Keyholderin",
/// bleibt richtig: sie ändert nichts daran, dass die Vergangenheit stillhalten muss. Der Träger
/// darf weiter umstellen — nur eben mit Wirkung ab jetzt.
model TimezoneChange {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone      String
  /// Ab wann diese Fassung gilt. Die Grundzeile trägt Epoch — vor der ersten Umstellung ist bekannt,
  /// DASS diese Zone galt, nicht seit wann; ein erfundener Zeitpunkt liesse eine Lücke, in die eine
  /// Öffnung fallen könnte (gleiche Regel wie `CLEANING_RULES_EPOCH`).
  effectiveFrom DateTime
  /// Wer umgestellt hat. `null` = die Grundzeile, die niemand gesetzt hat.
  changedBy     String?
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
}

model CleaningRuleChange {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vollständiger Stand ab `effectiveFrom` — Spiegel der vier User-Spalten, nicht ein Delta: die
  /// Ableitung braucht für einen Zeitpunkt alle vier Werte, und ein Delta müsste sie erst wieder
  /// über die ganze Historie zusammensetzen.
  allowed       Boolean
  maxMinutes    Int
  maxPerDay     Int
  /// Wie `User.reinigungsFenster`: JSON-Liste der Tages-Fenster, null = keine gesetzt.
  windows       String?
  effectiveFrom DateTime
  /// Username dessen, der geändert hat (bzw. `ai`). Null nur bei der Grundzeile.
  changedBy     String?
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
}

/// Eine Änderung an der Regel „zählt diese Vergehensart bei diesem Sub?" — append-only.
///
/// Warum eine HISTORIE und kein Schalter-Feld am User: Das Strafbuch ist eine Live-Ableitung. Ein
/// einzelnes `enabled` würde beim Umlegen rückwirkend die ganze Vergangenheit umschreiben —
/// Einschalten liesse Vergehen für Handlungen erscheinen, die zu ihrer Zeit erlaubt waren (genau der
/// Fehler, gegen den `cleaningWindowEnforcedFrom` gebaut wurde), Ausschalten liesse bereits
/// geahndete Vorfälle spurlos verschwinden. Mit der Historie wird jede Handlung nach der Fassung
/// beurteilt, die zu IHREM Zeitpunkt galt: die geltende Regel für t ist die jüngste Zeile mit
/// `effectiveFrom <= t`, sonst der Code-Default (= bisheriges Verhalten).
///
/// `mode` statt `enabled`, weil nicht jede Art binär ist: `unauthorized_orgasm` kennt zusätzlich
/// „nur während einer Sperrzeit". Gültige Werte je Art stehen in `offenseRules.ts`.
model OffenseRuleChange {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kanonischer Vergehenstyp (Schlüssel aus STORED_TYPE, z.B. "unauthorized_opening").
  offenseType   String
  mode          String
  effectiveFrom DateTime
  /// Username dessen, der umgelegt hat.
  changedBy     String
  createdAt     DateTime @default(now())

  @@index([userId, offenseType, effectiveFrom])
}

// Eine Nachricht im Posteingang. Das Gegenstück zu den Mail-/Push-Meldungen, die bisher nach dem
// Versand nirgends mehr existierten — vor allem der Straftext, den der Sub sonst nur in der Mail
// sah (das Strafbuch ist admin-only).
//
// GENAU EINES der beiden Inhalts-Paare ist gesetzt, und die Render-Regel hängt an der Feld-Identität
// statt an einem Flag, das man vergessen kann:
//   bodyKey/bodyParams → i18n-Schlüssel, wird in der Sprache des LESERS gerendert
//   body               → Menschentext, nie übersetzt, nie interpoliert
// Erzwungen wird das von den Factories in messageService.ts (SQLite kennt den Constraint nicht).
model Message {
  id            String  @id @default(cuid())
  // Der Sub, um den es geht — IMMER der Scope-Schlüssel, damit der Rechte-Check exakt der bestehende
  // ist und kein zweiter Sichtbarkeits-Pfad entsteht.
  subjectUserId String
  subject       User    @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)

  // Wer getippt hat: "system" | "keyholder" | "ai" — Vorbild StrafeRecord.judgedBy. Eine Art, kein
  // Name: WELCHE Person es war, kann diese Spalte nicht sagen.
  senderKind String

  /// Der NAME des Absenders, wo ein Mensch dahintersteht — sonst null.
  ///
  /// Heute setzt ihn genau ein Schreiber: die Meldung eines VON HAND notierten Vergehens
  /// (offenseAnnounce.ts, aus `ManualOffense.createdBy`). Hat die Keyholderin es notiert, ist sie die
  /// Absenderin; „System" wäre dort schlicht falsch. `null` heisst „kein persönlicher Autor" — die
  /// Zeile trägt dann wie bisher die Bezeichnung ihrer `senderKind`.
  ///
  /// Gefüllt NUR zusammen mit `senderKind = "keyholder"`. Zu „system"/„ai" gehört keine Person, und
  /// ein Name daneben wäre ein Widerspruch, den keine Anzeige und kein Filter je läse. Erzwungen
  /// wird das an der einen Schreibstelle (`recordSystemMessage`), nicht per Constraint — SQLite
  /// kennt keinen, und es gibt nur diesen einen Weg in die Tabelle.
  ///
  /// KOPIERT und nicht über die `ref` nachgelesen — die Ausnahme von „Freitexte werden VERLINKT"
  /// (siehe `refEntityType` unten). Diese Regel schützt vor ZWEI WAHRHEITEN und meint deshalb
  /// veränderlichen Text: ein korrigierter Straftext darf nicht neben seiner alten Kopie stehen.
  /// `ManualOffense.createdBy` ist aber UNVERÄNDERLICH — `manualOffenseService.ts` kennt Anlegen und
  /// Zurückziehen, keinen Umschreib-Pfad —, also gibt es keine zweite Fassung, von der die Kopie
  /// abweichen könnte. Was es gibt, ist der umgekehrte Fall: die Nachricht ist der Beleg einer
  /// ZUSTELLUNG und muss wahr bleiben, auch wenn das Vergehen später zurückgezogen wird; nachgelesen
  /// wäre der Absender dann weg. Zudem ist diese Meldung ohnehin schon eine Momentaufnahme — ihren
  /// TITEL trägt sie seit jeher in `bodyParams` (`detectedParams` in offenseAnnounce.ts), aus
  /// genau demselben Grund.
  ///
  /// NICHT MEHR NUR DIESE EINE MELDUNG. Der Absatz stand hier lange andersherum: die beiden Zeilen
  /// zum Urteil — Strafe verhängt und Vergehen verworfen (strafurteilService.ts) — könnten ihren
  /// Autor nicht nennen, weil das einzige Autoren-Feld `StrafeRecord.judgedBy` nur ein Kürzel führe.
  /// Das stimmt seit `judgeOffense(p, actor)` nicht mehr: beide reichen den Handelnden an
  /// `recordSystemMessage` durch und tragen seinen Namen. Die Einschränkung galt für die SPALTE, nie
  /// für den Weg dorthin — sie wurde nur nie nachgeführt.
  ///
  /// Was tatsächlich fehlte, war der gespeicherte Name AM URTEIL: `judgedBy` faltet den Handelnden
  /// weiterhin auf "ai"/"admin"/"system" zusammen (die Strafbuch-Optik hängt an diesem Kürzel).
  /// Deshalb steht der Name seither zusätzlich in `StrafeRecord.judgedByName` — additiv, damit das
  /// Kürzel und alles, was darauf rechnet, unverändert bleibt.
  ///
  /// BEKANNTE GRENZEN (bewusst offen, nicht vergessen):
  ///  * Der Absender-FILTER (`MessageFilterBar`) filtert nach ART, nicht nach Namen. Seine Auswahl
  ///    „Keyholder" trägt deshalb den Namen der Seite (der EINE Keyholder des Trägers), während die
  ///    Zeilen darunter ihren eigenen Autor zeigen. Auf einer Instanz mit mehreren Admins können
  ///    beide auseinanderfallen — die Auswahl nennt dann eine Person und meint alle.
  ///  * Ein Benutzer, der wirklich `ai` hiesse, würde als KI gelesen. Warum er nicht existieren
  ///    kann, steht kanonisch bei `AI_AUTHOR` (src/lib/constants.ts).
  senderName String?

  // "sub" = an den Sub · "keyholders" = an dessen Keyholder. Bei BEIDEN ist subjectUserId der SUB.
  //
  // KANONISCH — hier steht die Begründung, andere Stellen (messageService.ts, notify.ts) zeigen
  // hierher: Eine Keyholder-Meldung ist EINE Zeile je Träger, die sich alle seine Keyholder teilen.
  // Wer gelesen hat, steht in MessageRead.userId (dem LESER), also hat jeder Keyholder auf derselben
  // Zeile seinen eigenen Stand — deshalb braucht der Keyholder-Kanal keine Migration und keine Zeile
  // je Empfänger. Die Kehrseite: Löschen trifft alle (siehe deleteMessages in messageService.ts).
  //
  // JEDE Abfrage auf diese Tabelle muss audience mitfiltern; subjectUserId allein trennt die beiden
  // Sichten nicht mehr.
  audience String

  bodyKey    String?
  bodyParams String? // JSON als String; SQLite/Prisma 5 kennen kein Json-Feld
  body       String?

  // Bezug aufs Tracking-Objekt, Muster von NoteRef. Freitexte werden VERLINKT statt kopiert: eine
  // spätere Korrektur am Straftext wirkt damit rückwirkend richtig, statt zwei Wahrheiten zu erzeugen.
  refEntityType String?
  refEntityId   String?

  createdAt DateTime @default(now())

  reads MessageRead[]

  // Der EINE Index, den die Abfragen brauchen: Liste, Zähler und "alle als gelesen" filtern alle
  // auf (subjectUserId, audience) und sortieren nach createdAt.
  /// `id` gehört mit in den Index: sortiert wird `createdAt DESC, id DESC` (createdAt allein ist
  /// nicht eindeutig), und in SQLite steckt der TEXT-Primärschlüssel NICHT implizit im Index. Ohne
  /// ihn schiebt SQLite einen temporären B-Baum für den letzten Sortier-Term dazwischen.
  @@index([subjectUserId, audience, createdAt, id])
  /// Der Abgleich „welche Vergehen wurden diesem Träger schon gemeldet?" (offenseAnnounce.ts) fragt
  /// `WHERE subjectUserId = ? AND refEntityType = ?`. Der Index oben hat `audience` an zweiter
  /// Stelle und kann das nicht bedienen — ohne diesen hier scannt jeder Melde-Lauf die ganze
  /// Nachrichten-Tabelle des Trägers, und der Lauf läuft im Minuten-Poller über alle Träger.
  @@index([subjectUserId, refEntityType, refEntityId])
}

// Gelesen-Kennzeichen je Leser. Eigene Tabelle statt Flag an der Nachricht, weil eine Nachricht an
// die Keyholder ab Etappe 2 mehrere Leser hat.
model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  /// Der Ungelesen-Filter fragt `WHERE userId = ?` — der Unique-Index oben hat `messageId` zuerst
  /// und kann das nicht bedienen. Ohne diesen Index scannt JEDE Ungelesen-Abfrage die ganze Tabelle
  /// über alle Nutzer, und die hängt an der Glocke im Header, also an jeder Dashboard-Seite.
  @@index([userId, messageId])
}

// Gesundheits-Zurückhaltung (§8): ein Signal, dass aus Gesundheitsgründen (Migräne/Aura, Schlaf,
// Blutdruck) gerade Zurückhaltung gilt. Aktuell aktiver Hold = active=true, resolvedAt=null.
// MCP-only, additiv — der Tracker liest diese Tabellen nicht.
model HealthHold {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active     Boolean   @default(true)
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, active])
}

// Wiederkehrender Wochen-Kontext (§8): HO-Tage, Bürotage, Pilates-Slots … damit der Keyholder
// Anker/Kontrollen ums echte Leben plant. weekday: 0=So .. 6=Sa. deviceFree = Slot ist gerätefrei.
model RecurringContext {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String // z.B. "Home Office", "Pilates"
  weekday    Int // 0=So .. 6=Sa
  // null = jede Woche (Default, bisheriges Verhalten). 1..5 = n-ter <weekday> im Monat.
  // -1 = letzter <weekday> im Monat (z.B. "erster Mittwoch" = weekday:3, ordinal:1).
  ordinal    Int?
  // Optimistic-Concurrency-Token: inkrementiert bei jedem MCP-Edit (siehe writeFramework).
  version    Int      @default(1)
  deviceFree Boolean  @default(false)
  // JSON-Array von Ausnahme-Daten ("YYYY-MM-DD"), an denen der Slot NICHT stattfindet (iCalendar-
  // EXDATE-Modell). null/leer = keine Ausnahmen. Der Planer wendet sie beim Aufzählen der Termine an.
  exclusionDates String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Einzeltermine (§8): geräte-frei-Termine (Arzt, Therapie) + Hitze-Ausnahmen, strukturiert statt Prosa.
model Appointment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  when       DateTime
  typ        String? // z.B. "Therapie", "Arzt"
  deviceFree Boolean  @default(false)
  note       String?
  // Optimistic-Concurrency-Token: inkrementiert bei jedem MCP-Edit (siehe writeFramework).
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([userId, when])
}

// Append-only Audit-Log jeder mutierenden MCP-V2-Aktion (Pflicht-`reason` + `source`).
// Deckt §9.2 (Action-Log) und §6 (Goal-Audit-Historie) ab: die nächste Keyholder-Instanz
// erbt Entscheidungen samt Begründung, nicht nur Zustände. MCP-only, additiv — der Tracker
// schreibt/liest diese Tabelle nicht.
model KeyholderActionLog {
  id        String   @id @default(cuid())
  userId    String // Ziel-User der Aktion (MCP_USERNAME)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String // MCP-Tool-Name, z.B. "set_training_goal" | "judge_offense" | "upsert_note"
  actor     String? // OAuth-userId des handelnden Keyholders (null = unbekannt/legacy)
  reason    String // Pflicht-Begründung — nie stille Mutation
  source    String   @default("agent") // agent | user-stated
  argsJson  String? // Tool-Input als JSON (Audit)
  resultRef String? // erzeugte/betroffene Entity-id (Goal, Sperrzeit, Note ...)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Freie Beobachtungen, die der virtuelle Keyholder (MCP-KI) zum Trageverhalten ablegt und
// später wieder auswertet. NUR über den MCP zugänglich — kein Sub-/Admin-UI. kg/kategorie
// sind optionale Freitext-Tags (z.B. Gerätename bzw. "Druckstelle"/"Ausbruchsversuch"/"Gemecker").
model KeyholderNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kg        String?
  kategorie String?
  text      String
  createdAt DateTime @default(now())

  // ── Notes v2 (MCP-only, additiv — Tracker liest diese Felder nicht) ──
  // type: DIRECTIVE | BOUNDARY | OBSERVATION | CORRECTION | EQUIPMENT | DATA | HISTORY
  type         String    @default("OBSERVATION")
  // status: active | superseded | archived  (Supersession statt Delete)
  status       String    @default("active")
  pinned       Boolean   @default(false)
  // Vorgänger-Note, die diese hier ablöst (status der alten → superseded). Reiner id-Pointer.
  supersedesId String?
  // source: user-stated | inferred  — trennt Nutzer-Fakt von Agenten-Schluss
  source       String    @default("inferred")
  // confidence: low | medium | high (optional, v.a. für inferred)
  confidence   String?
  validFrom    DateTime?
  validUntil   DateTime?
  // doDont: JSON {"do":[...],"dont":[...]} — strukturiert für BOUNDARY-Notes
  doDont       String?
  // Optimistic-Concurrency-Token: inkrementiert bei jedem MCP-Edit (siehe writeFramework).
  version      Int       @default(1)

  refs NoteRef[]

  @@index([userId, createdAt])
  @@index([userId, status, pinned])
  @@index([supersedesId])
}

// Polymorphe Verknüpfung einer Keyholder-Note an ein Tracking-Objekt (das fehlende Bindeglied).
// Bidirektional: ein geholtes Objekt bringt seine Notes inline mit, eine Note zeigt auf ihre Belege.
// entityId für segment ist die Re-Lock-Entry-id des Teilstücks (berechnet, nicht persistiert).
model NoteRef {
  id         String        @id @default(cuid())
  noteId     String
  note       KeyholderNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // entityType: device | session | segment | control | offense | orgasmDirective | goal | appointment
  entityType String
  entityId   String
  createdAt  DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([noteId])
}

// User-defined device categories (KG, Plug, Collar, Cuffs, ...).
// One built-in "kg" category is seeded per user — it cannot be deleted and keeps
// KG-specific features (photo-pflicht, seal-detection, kontrollen, reinigung).
// All other categories are user-defined and have plain wear-tracking only.
model DeviceCategory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String // user-editable display name
  slug            String // stable identifier; "kg" for built-in
  color           String // CSS-variable suffix (e.g. "cat-steel", "cat-plum")
  icon            String // Name aus CATEGORY_ICONS (meist lucide, vier eigene Zeichnungen) (e.g. "Lock", "Crown")
  isBuiltIn       Boolean  @default(false) // true only for KG; cannot be deleted
  trackingEnabled Boolean  @default(true) // when false: inventory-only, no wear sessions
  requirePhoto    Boolean  @default(false) // when true: WEAR_BEGIN entries require an imageUrl
  allowVorgaben   Boolean  @default(true) // when false: category cannot be linked to TrainingVorgaben
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  devices  Device[]
  vorgaben         TrainingVorgabe[]
  taskRequirements TaskRequirement[]
  kontrollen       KontrollAnforderung[]

  @@unique([userId, slug])
  @@index([userId])
}

// WebAuthn passkeys for biometric login (Face ID, Touch ID, Fingerprint, Windows Hello).
// One user can have multiple passkeys (e.g. phone + laptop).
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url-encoded credential ID
  publicKey    String // base64url-encoded public key
  counter      Int       @default(0)
  transports   String? // JSON array of transport strings (e.g. ["internal","hybrid"])
  deviceName   String? // user-chosen label (e.g. "iPhone 15")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TrainingVorgabe {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String? // nullable until backfilled; future: required
  category         DeviceCategory? @relation(fields: [categoryId], references: [id])
  gueltigAb        DateTime
  gueltigBis       DateTime?
  // true = Enddatum bewusst vom Keyholder gesetzt → Auto-Verkettung (reorderVorgabenDates)
  // darf es NICHT überschreiben. false = Ende ergibt sich aus der Verkettung (Start der Folge-
  // Vorgabe) bzw. offen, wenn es die neueste ihrer Kategorie ist.
  validUntilManual Boolean         @default(false)
  minProTagH       Float?
  minProWocheH     Float?
  minProMonatH     Float?
  // 4. Zielperiode „Jahr" (Stunden). Folgt bewusst der deutschen Feld-Familie minProTagH/WocheH/MonatH
  // (Konsistenz der Geschwister), obwohl neue Identifier sonst englisch benannt werden.
  minProJahrH      Float?
  notiz            String?
  createdAt        DateTime        @default(now())
  // Soft-Delete (B-04, MCP-Befundliste 2026-07-17): null = aktiv. Gesetzt = gelöscht, Zeile bleibt
  // für die Historie erhalten (explain_model §13 verspricht "Supersession statt Delete" als
  // durchgängiges Prinzip — vorher galt für Trainingsziele das Gegenteil, harter Delete ohne Spur).
  deletedAt        DateTime?

  @@index([userId])
  @@index([categoryId])
  // Spiegelt Device.@@index([userId, archivedAt]) — dieselbe "aktive Zeilen eines Users" Query-Form,
  // die listVorgaben/getActiveVorgabe/reorderVorgabenDates etc. jetzt alle über deletedAt filtern.
  @@index([userId, deletedAt])
}

model KontrollAnforderung {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null = diese Kontrolle verlangt keinen Code (Gerät mit `requireInspectionCode: false`). Dann ist
  // der Code auch nicht der Schlüssel, über den der eingereichte Eintrag seine Anforderung findet —
  // das tut die „eine offene Anforderung"-Regel in der entries-Route.
  code                     String?
  // ZIEL der Kontrolle. Beide null = der KG (Bestandsverhalten): die Kontrolle hängt am aktiven
  // VERSCHLUSS. `categoryId` gesetzt = Trage-Kontrolle auf diese Kategorie („zeig mir den Plug"),
  // erfüllt aus der laufenden WEAR-Session. `deviceId` zusätzlich verengt sie auf GENAU dieses
  // Gerät und hat Vorrang — dieselbe Kategorie/Gerät-Staffelung wie bei TaskRequirement.
  // SetNull statt Cascade: eine gelöschte Kategorie darf die Kontroll-Historie nicht mitreissen.
  categoryId               String?
  category                 DeviceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deviceId                 String?
  device                   Device?   @relation("KontrolleDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  kommentar                String?
  /// Username des Keyholders/Admins, der die Kontrolle angefordert hat, bzw. die KI-Kennung `ai` für
  /// den Weg über den MCP. Gleiche Bedeutung und gleicher Wertebereich wie `ManualOffense.createdBy`.
  ///
  /// Gebraucht wird die Spalte für die ZUSTELLUNG: eine TERMINIERTE Kontrolle (`wirksamAb`) meldet
  /// der Poller, lange nachdem der Mensch den Knopf gedrückt hat — ohne dieses Feld weiss er nicht,
  /// WER sie gestellt hat, und die Nachricht im Posteingang müsste ihren Absender raten. Gelesen
  /// wird sie über `senderFromAuthor` (messageService.ts).
  ///
  /// `null` heisst „kein Mensch dahinter": so entstehen die AUTO-Kontrollen (autoKontrolleService.ts)
  /// — und so bleiben alle Zeilen von vor dieser Spalte. Beide melden wie bisher als „System".
  createdBy                String?
  deadline                 DateTime
  createdAt                DateTime  @default(now())
  fulfilledAt              DateTime? // Server-seitig gesetzt beim Erstellen des PRUEFUNG-Eintrags – nie editierbar
  withdrawnAt              DateTime?
  // Zeitversetzte Auslösung: null = sofort. Gesetzt = geplant; bis dahin für den Sub
  // unsichtbar, Benachrichtigung + Frist starten erst dann (Poller verschickt sie).
  wirksamAb                DateTime?
  benachrichtigtAt         DateTime? // wann Mail/Push raus ging (sofort beim Anlegen, oder per Poller)
  auto                     Boolean   @default(false) // automatisch generiert (Auto-Kontrollen); manuelle = false
  entryId                  String?   @unique
  entry                    Entry?    @relation("KontrolleEntry", fields: [entryId], references: [id], onDelete: SetNull)
  // Kontroll-Eskalation: benachrichtigtReminderAt wird gestempelt, sobald die Stufe-1-Verzögerung
  // abgelaufen ist (unabhängig davon, ob die Mahnung dem Sub tatsächlich zugestellt wird — dient
  // als Uhr-Anker für Stufe 2, siehe inspectionEscalationService.ts). autoMarkedRemovedAt markiert,
  // dass Stufe 2 ausgelöst hat; autoMarkedEntryId ist eine EIGENE FK zur dabei erzeugten
  // OEFFNEN-Entry — NICHT die entryId/"KontrolleEntry"-Relation, die exklusiv für die erfüllende
  // PRUEFUNG reserviert bleibt (ein Auto-Mark ist das Gegenteil von Erfüllung).
  benachrichtigtReminderAt DateTime?
  autoMarkedRemovedAt      DateTime?
  autoMarkedEntryId        String?   @unique
  autoMarkedEntry          Entry?    @relation("KontrolleAutoMarkedEntry", fields: [autoMarkedEntryId], references: [id], onDelete: SetNull)
  // HERKUNFT dieser Auto-Zeile: aus einem Wiederverschluss nach einer Reinigungspause statt aus dem
  // gewürfelten Tagesplan. Nicht aus der Zeile rekonstruierbar, deshalb eine Spalte; was daran hängt,
  // steht bei `scheduleCleaningRelockInspection`.
  cleaningRelock           Boolean   @default(false)

  @@index([userId, withdrawnAt])
  @@index([userId, entryId])
  @@index([wirksamAb])
  @@index([userId, autoMarkedRemovedAt])
  // „Läuft für DIESES Ziel schon eine Kontrolle?" — der Guard, der beim Anlegen JEDER Kontrolle
  // läuft (hasActiveKontrolle), filtert auf userId + categoryId.
  @@index([userId, categoryId])
}

model VerschlussAnforderung {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  art              String // "ANFORDERUNG" | "SPERRZEIT"
  message          String?  @map("nachricht")
  /// Username des Keyholders/Admins, der die Direktive gestellt hat, bzw. `ai` über den MCP —
  /// dieselbe Spalte und dieselbe Begründung wie `KontrollAnforderung.createdBy`: eine terminierte
  /// Anforderung/Sperrzeit stellt der Poller zu, und nur diese Spalte sagt ihm, wer sie angeordnet hat.
  ///
  /// Vererbt an jede SPERRZEIT, die aus einer ANFORDERUNG entsteht — beim Einschliessen des Subs
  /// (`entryFulfilment.ts`) wie bei der Übernahme am Poller (`carryOverSperrzeitOnAlreadyLocked`):
  /// die Sperre ist die Anordnung DERSELBEN Person, nur später wirksam. `null` = Altbestand bzw.
  /// keine Person feststellbar → die Meldung bleibt eine System-Zeile.
  createdBy        String?
  endsAt           DateTime? @map("endetAt") // ANFORDERUNG: Frist zum Einschliessen; SPERRZEIT: darf nicht öffnen bis
  dauerH           Float? // ANFORDERUNG only: Mindest-Tragedauer (h) – erzeugt nach Einschliessen automatisch SPERRZEIT (relativ zur Verschlusszeit)
  lockEndsAt       DateTime? @map("sperrEndetAt") // ANFORDERUNG only: absolutes Sperr-Ende (Wanduhr). Wird bei Fulfill 1:1 als SPERRZEIT.endsAt übernommen – unabhängig vom tatsächlichen Verschlusszeitpunkt (Spät-Verschluss verschiebt das Ende NICHT). Alternative zu dauerH.
  deviceId         String?
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  reinigungErlaubt Boolean   @default(false) // SPERRZEIT: Reinigungsöffnung bricht die Sperre nicht. ANFORDERUNG mit dauerH: wird auf erzeugte SPERRZEIT vererbt.
  createdAt        DateTime  @default(now())
  fulfilledAt      DateTime? // ANFORDERUNG: gesetzt wenn User VERSCHLUSS erstellt
  withdrawnAt      DateTime?
  // WARUM withdrawnAt gesetzt wurde. Ohne dieses Feld sah eine vom Sub aufgebrochene Sperrzeit
  // exakt aus wie eine, die die Keyholderin bewusst zurückgezogen hat — und wie eine, die es nie
  // gab. Die Konsequenz verschwand spurlos aus dem Dashboard.
  //   "keyholder" = bewusst zurückgezogen (withdraw / Admin-UI)
  //   "opening"   = durch eine Öffnung des Subs unterbrochen (releaseSperrzeitenOnOpen)
  // null = noch aktiv, ODER Altbestand vor v4.50.30 (dann ist die Endart nicht mehr rekonstruierbar).
  endedReason      String?
  // Zeitversetzte Auslösung: null = sofort. Gesetzt = geplant; bis dahin für den Sub
  // unsichtbar (gilt nicht als aktiv), Benachrichtigung + Frist starten erst dann (Poller verschickt sie).
  wirksamAb        DateTime?
  benachrichtigtAt DateTime? // wann Mail/Push raus ging (sofort beim Anlegen, oder per Poller)

  @@index([userId, art, withdrawnAt])
  @@index([wirksamAb])
}

// n:m relationship between admins and the users they supervise.
// Additive migration — no existing data is changed.
// Only active when USE_ADMIN_RELATIONSHIPS=true (feature flag).
model AdminUserRelationship {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminRelationships", fields: [adminId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserRelationships", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adminId, userId])
  @@index([adminId])
  @@index([userId])
}

// Tracks consumed portal-login JTIs to prevent replay attacks.
// Rows older than 1h are pruned automatically by the portal-login endpoint.
model PortalTokenUsed {
  jti    String   @id
  usedAt DateTime @default(now())
}

// Native push tokens for Capacitor apps (APNs on iOS, FCM on Android).
// One row per device per user; token is the unique device push token.
model NativePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // "ios" | "android"
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Web Push subscriptions for PWA push notifications.
// One row per browser/device per user; endpoint is the unique push endpoint URL.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Persistent rate limiting — replaces in-memory Maps across all API routes.
// key format: "ip:<ip>" | "user:<userId>" | "login:<username>" | "fp:<ip>"
// Expired rows are deleted on each check (no background job needed for SQLite).
model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}

// Passwortwechsel an einem ADMIN-Konto, während für einen Sub eine Sperrzeit lief.
//
// Warum überhaupt gespeichert: Das Strafbuch ist eine Live-Ableitung aus Einträgen und
// Anforderungen — ein Passwortwechsel hinterlässt dort nichts (der Reset-Token wird beim Einlösen
// gelöscht). Ohne diese Zeile gäbe es nichts, woraus sich das Vergehen ableiten liesse.
//
// Warum der Sperrzeit-Zustand hier festgeschrieben wird und nicht beim Lesen neu berechnet: Eine
// später zurückgezogene oder bearbeitete Sperrzeit würde das Vergehen sonst rückwirkend
// verschwinden lassen. `subUserId` ist der Sub, dessen Sperrzeit lief — ihm gehört das Vergehen,
// nicht dem Admin-Konto, dessen Passwort geändert wurde (beim Solo-Spieler dieselbe Person, aber
// zwei Konten). Ein Wechsel während mehrerer laufender Sperrzeiten erzeugt je Sub eine Zeile.
//
// Es wird NUR dieser eine Fall erfasst: Ziel ist ein Admin-Konto UND es lief eine Sperrzeit.
// Alltägliche Passwortwechsel bleiben ungespeichert — sonst ertrinkt der eine Eintrag, auf den es
// ankommt, im Rauschen.
model AdminPasswordChange {
  id             String   @id @default(cuid())
  // Der Sub, dessen Sperrzeit lief — Eigentümer des Vergehens, Filter von buildStrafbuch.
  subUserId      String
  subUser        User     @relation("AdminPasswordChangeSub", fields: [subUserId], references: [id], onDelete: Cascade)
  // Das Admin-Konto, dessen Passwort geändert wurde.
  adminUserId    String
  adminUsername  String // Abbild zum Zeitpunkt der Änderung — überlebt Umbenennung und Löschung
  // Weg: "reset_token" (Postfach-Zugriff — der interessante Fall) | "self" | "set_by_other"
  via            String
  // Wer die Änderung ausgelöst hat; null beim Token-Weg (keine Sitzung).
  actorUserId    String?
  // Die Sperrzeit, die zum Zeitpunkt lief — für die Anzeige, nicht als Fremdschlüssel-Zwang:
  // sie darf gelöscht werden, ohne das Vergehen mitzunehmen.
  lockPeriodId   String?   @map("sperrzeitId")
  lockPeriodEndsAt DateTime? @map("sperrzeitEndetAt")
  createdAt      DateTime @default(now())

  @@index([subUserId, createdAt])
}

// Urteil über ein erkanntes Vergehen. Lebenszyklus: erkannt (kein Record) →
// verworfen (status=DISMISSED) | bestraft (status=PUNISHED). Identität des Vergehens
// über (offenseType, refId); refId ist die Entry-/Kontrolle-/Anforderungs-id.
model StrafeRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offenseType   String // "KONTROLLANFORDERUNG" | "OEFFNEN_ENTRY" | "AUTO_ENTFERNT" | "VERSCHLUSS_ANFORDERUNG" | "REINIGUNG_LIMIT" | "FALSCHES_GERAET" | "ORGASMUS_ANWEISUNG" | "REINIGUNG_NICHT_VERSCHLOSSEN"
  refId         String    @unique
  bestraftDatum DateTime // Urteilszeitpunkt (bei PUNISHED = Strafdatum)
  notiz         String?
  // Urteils-Status + Audit
  status        String    @default("PUNISHED") // "PUNISHED" | "DISMISSED"
  reason        String? // DAS eine Freitextfeld: Strafe-Text bei PUNISHED, optionaler Grund bei DISMISSED
  judgedBy      String? // "ai" | "admin" | "system"
  /// Der NAME dessen, der geurteilt hat — zusätzlich zum Kürzel in `judgedBy`, nicht an seiner Stelle.
  ///
  /// Additiv, weil das Kürzel load-bearing ist: die Strafbuch-Optik unterscheidet daran, ob die KI
  /// oder ein Mensch entschieden hat, und die MCP-Sicht liefert es unverändert weiter. Ein Umdeuten
  /// hätte beides gebrochen und einen `schemaVersion`-Bump verlangt.
  ///
  /// `null` heisst „kein Name festgehalten": Altbestand (vor dieser Spalte), die automatische Ahndung
  /// (`judgedBy: "system"` — dahinter steht niemand) und das Urteil der KI, deren Kennung bereits im
  /// Kürzel steht. Die Anzeige nennt den Namen also nur da, wo es wirklich einen gibt.
  ///
  /// Der Handelnde lag schon immer an: `judgeOffense(p, actor)` bekommt ihn, und die Meldungen im
  /// Posteingang tragen ihn längst (siehe `Message.senderName`). Zusammengefaltet wurde er erst eine
  /// Ebene tiefer, in `judgedByFromActor` — auf einer Instanz mit zwei Admins konnte das Strafbuch
  /// deshalb nicht sagen, wer entschieden hat.
  judgedByName  String?
  erledigtAt    DateTime? // nur PUNISHED: null = Strafe offen, gesetzt = erledigt (Loop geschlossen)
  createdAt     DateTime  @default(now())
  /// Die Aufgabe, die DIESE Strafe ist — statt „20 Schläge" als Freitext eine gestellte Aufgabe mit
  /// Frist. Null bei Freitext-Strafen und bei jedem DISMISSED.
  ///
  /// Die Spalte trägt drei Dinge: die Herkunft (das Strafbuch weist eine versäumte Strafaufgabe als
  /// Glied einer Kette aus), das Aufräumen (wird ein Urteil ersetzt oder zurückgenommen, zieht
  /// `writeJudgment` die daran hängende Aufgabe zurück) und den Abschluss — eine erfüllte Aufgabe
  /// setzt `erledigtAt` von selbst (`settleTaskResult`), statt auf einen Klick des Keyholders zu warten.
  taskId        String?
  /// `SetNull`, nicht `Cascade`: ein Urteil ist die Aufzeichnung einer Entscheidung und überlebt die
  /// Aufgabe — aber nur, wenn es zu diesem Zeitpunkt noch etwas aufzeichnet. Ein noch OFFENES Urteil
  /// nimmt der Rückzug der Aufgabe mit (`withdrawTask` → `dropJudgments`), und gelöscht werden darf
  /// eine Aufgabe erst nach dem Rückzug. Übrig bleibt für `SetNull` also die abgeleistete Strafe:
  /// sie bleibt stehen, wenn ihre Aufgabe später weggeräumt wird. Vorher blieb hier auch eine offene
  /// stehen — eine Strafe ohne Aufgabe und ohne Text, die für immer in `pendingPenalties` zählte
  /// und von einer Freitext-Strafe nicht mehr zu unterscheiden war (Befund 16.08.2026).
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
}

model Device {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String? // nullable until backfilled; future: required for new devices
  category      DeviceCategory? @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  imageUrl      String?
  purchasePrice Float?
  currency      String? // "CHF" | "EUR" | "USD"
  createdAt     DateTime        @default(now())
  archivedAt    DateTime? // Soft-delete: null = active, set = archived

  // ── Geräte-Metadaten für Keyholder-Entscheidungen (MCP-only, additiv) ──
  // securityLevel: SECURING | TRUST_ONLY — Vertrauensgerät vs. sicherndes Gerät, maschinenlesbar
  securityLevel      String?
  // lookalikeClusterId: gleiche Optik = gleicher Cluster. Mismatch INNERHALB eines Clusters ist soft, nie ein Vergehen.
  lookalikeClusterId String?
  pullOffRisk        Boolean? // true = abstreifbar (unsicher), false = geprüft sicher, null = nie beurteilt (K-08)
  // Verlangt eine Kontrolle mit DIESEM Gerät den handschriftlichen Kontroll-Code im Foto?
  // Default true = Bestandsverhalten. false: die Anforderung entsteht ohne Code, das Formular fragt
  // keinen ab, und die Erfüllung läuft über die eine offene Anforderung statt über den Code-Vergleich
  // (siehe kontrolleService/entries-Route). Nur vom Keyholder/Admin setzbar — es schwächt eine
  // Kontrolle, und ein Sub, der sie selbst abschalten kann, kontrolliert sich nicht mehr.
  requireInspectionCode Boolean @default(true)
  material           String? // Edelstahl | Kunststoff | Silikon
  bauform            String? // flach | voll | standard | Plug ...
  healthFlags        String? // JSON string[] — Druckstellen, scheuert, rutscht ...
  retentionNotes     String? // z.B. "njoy: rutscht beim Entspannen"
  // Optimistic-Concurrency-Token: inkrementiert bei jedem MCP-Edit (siehe writeFramework).
  version            Int     @default(1)

  entries                 Entry[]
  verschlussAnforderungen VerschlussAnforderung[]
  boxEvents               BoxEvent[]
  referenceImages         DeviceReferenceImage[]
  taskRequirements        TaskRequirement[]
  kontrollen              KontrollAnforderung[] @relation("KontrolleDevice")

  @@index([userId, archivedAt])
  @@index([categoryId])
}

/// Kuratierte Referenzfotos je Gerät — „Trainingsmaterial" für die Geräte-Erkennung
/// (Few-Shot in detectDevice). Eigene Datei-Kopie unter data/uploads; sourceEntryId
/// dokumentiert die Herkunft, falls aus einem Verschluss-Eintrag importiert.
/// embedding*-Spalten sind für einen späteren Embedding-Index (Phase 3) reserviert und
/// in der Few-Shot-Phase leer.
model DeviceReferenceImage {
  id             String   @id @default(cuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  imageUrl       String // /api/uploads/<filename>, wie Entry.imageUrl
  sourceEntryId  String? // Herkunft, falls aus einem bestehenden Entry importiert
  note           String?
  embedding      Bytes? // Phase 3: Float32-Vektor als Blob; vorerst leer
  embeddingModel String? // welches Modell den Vektor erzeugt hat (Invalidierung)
  createdAt      DateTime @default(now())

  @@index([deviceId])
}

// Hardware-Wahrheit der Heimdall-Schlüsselbox (Spur 2), getrennt vom selbst-
// erfassten Entry (Spur 1). Wird vom Heimdall-Server über /api/integration/box/*
// (Shared-Secret) eingespielt. Abgleich Entry↔BoxEvent erfolgt später (P3).
model BoxEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  type       String // "LOCKED" | "UNLOCKED" | "EARLY_OPEN" | "UNAUTHORIZED_OPEN"
  wakeReason String? // gemeldeter Öffnungsgrund der Box
  battery    Int? // 0–100
  fwVersion  String?
  at         DateTime // Zeitpunkt des Box-Ereignisses (server-autoritativ vom Heimdall-Sync)
  createdAt  DateTime @default(now())

  @@index([userId, at])
}

// Live-Zustand der Heimdall-Box(en) eines Users — vom Heimdall-Server bei jedem Box-Sync
// gepusht. Zeigt den Box-Status im Tracker (statt zweiter App). pendingCommand = vom Sub
// im Tracker ausgelöste Aktion, die Heimdall beim nächsten Sync zieht & anwendet.
model BoxStatus {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxId                  String // Heimdall-Geräte-id (stabil)
  name                   String
  locked                 Boolean   @default(false)
  // Physisches IST der frischen Sync-Meldung — `locked` ist das SOLL. Seit dem Präsenz-Guard
  // (FW 0.2.33) kann die Box offen stehen, obwohl sie zu sein soll. null = Alt-Zeile (Fallback SOLL).
  reportedLocked         Boolean?
  lockUntil              DateTime? // effektive Sperre (eigene + Tracker-Sperrzeit, gekappt)
  simpleLock             Boolean   @default(false)
  keyholderLocked        Boolean   @default(false) // durch Tracker-Sperrzeit gehalten (Sub kann lokal nicht öffnen)
  battery                Int?
  charging               Boolean?
  boltPos                String?
  fwVersion              String?
  lastSyncAt             DateTime?
  offlineOpenHours       Int? // Offline-Failsafe-Schwelle der Box → für staleLock/hardwareEnforced im MCP
  // Akku-Failsafe-Schwelle in Prozent: darunter öffnet die Box AUTONOM. Kommt aus demselben
  // Heimdall-Push wie `offlineOpenHours` — der Tracker soll die Firmware-Konstante nicht ein
  // drittes Mal kopieren. (Heimdall spiegelt sie seinerseits; die Box selbst meldet sie nicht.)
  // null = Alt-Zeile oder Heimdall vor diesem Feld → keine Akku-Vorwarnung (still, nicht geraten).
  lowBatteryOpenPercent  Int?
  // Aus einem Eintrag abgeleitetes, noch nicht vollzogenes Kommando. Kein Reinigungs-Kommando und
  // keine Frist: die Box öffnet auf "open" und bleibt offen, bis ein "lock" kommt.
  pendingCommand         String? // "lock" | "open"
  pendingCommandAt       DateTime?
  updatedAt              DateTime  @updatedAt

  @@unique([userId, boxId])
  @@index([userId])
}

model Entry {
  id                            String               @id @default(cuid())
  // Stempel des Client-Versuchs, der diese Zeile angelegt hat. Wozu: siehe `entryRequest()`.
  // Eindeutig NUR JE NUTZER (`@@unique` unten), nicht global — sonst müsste die Route den
  // Fremdtreffer als eigenen Fehlerfall behandeln, samt Code und Übersetzung, für eine
  // UUID-Kollision. So steckt die Sichtbarkeitsregel im Index statt in einer Laufzeit-Prüfung.
  clientRequestId               String?
  userId                        String
  user                          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                          String               @default("VERSCHLUSS")
  startTime                     DateTime
  imageUrl                      String?
  imageExifTime                 DateTime?
  // Bildersafe (Schlüssel-Verwahrung): versiegeltes Foto des Schlüsselbox-Codes. Getrennt von
  // imageUrl (offenes Siegel/Gerät). Wird erst freigegeben, wenn Öffnen erlaubt ist.
  codeImageUrl                  String?
  codeReadable                  Boolean? // detectSealNumber hat Ziffern erkannt (nur "lesbar ✓", Zahl wird NICHT gespeichert)
  // Nur VERSCHLUSS: Deklaration des Subs, ob der Schlüssel in der Heimdall-Box liegt.
  // false = er behält ihn (z.B. auf Reise) → die Box bekommt bewusst KEIN lock-Kommando
  // (siehe boxCommand.ts). null = nicht gefragt (keine Box, Admin-Pfad, Alt-Client/Alt-Eintrag).
  // Ohne dieses Feld wäre "nicht hardware-vollstreckt" nicht von "Box war offline" zu unterscheiden.
  keyInBox                      Boolean?
  // Box-Foto (Heimdall): Aufnahme durch das Sichtfenster der Box, die belegt, dass der Schlüssel
  // drin liegt — bei geschlossener Box, deshalb dieselbe Aufnahme für VERSCHLUSS und PRUEFUNG.
  // Getrennt von imageUrl (Gerät/Siegel) und codeImageUrl (Bildersafe).
  boxImageUrl                   String?
  // Hat die Vision im Sichtfenster einen Schlüssel erkannt? null = nicht geprüft (kein Foto, kein
  // Vision-Provider, oder Prüfung läuft noch). Advisory wie deviceCheck: die Keyholderin sieht es,
  // blockiert aber nichts. Erkennt "ein Schlüssel", NICHT "der richtige Schlüssel".
  keyDetected                   Boolean?
  note                          String?
  oeffnenGrund                  String?
  orgasmusArt                   String?
  kontrollCode                  String?
  verifikationStatus            String?
  // Warum die automatische Foto-Verifikation NICHT gematcht hat (nur gesetzt, wenn
  // verifikationStatus null ist, d.h. "unverified"). VerifyReason-Code aus verifyCode.ts
  // (codeMissing/codeWrong/sealMissing/sealWrong) — sprachneutral, UI übersetzt ihn.
  verifikationReason            String?
  // Bei codeWrong/sealWrong: die abweichend erkannte Nummer, für die {detected}-Interpolation
  // der Reason-Message. Bei *Missing ungesetzt.
  verifikationReasonDetected    String?
  // Geräte-Check der Kontrolle (PRUEFUNG): wird das verschlossene Gerät im Foto erkannt?
  // null = nicht geprüft · "ok" = passendes Gerät sichtbar · "wrong" = anderes Gerät · "missing" = kein Gerät.
  // Advisory (Keyholder sieht es), blockiert nicht. Server-seitig per Vision gesetzt.
  deviceCheck                   String?
  deviceCheckNote               String? // erkanntes Gerät (Name) oder null, wenn keins erkannt
  deviceCheckExpected           String? // erwartetes (verschlossenes) Gerät zur Check-Zeit
  deviceId                      String?
  device                        Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt                     DateTime             @default(now())
  // Wer/was diesen Eintrag angelegt hat — generischer Marker, nicht auf ein Feature beschränkt.
  // "system" bislang nur für die automatisch erzeugte OEFFNEN-Entry der Kontroll-Eskalation
  // (Stufe 2), siehe inspectionEscalationService.ts.
  source                        String               @default("user") // "user" | "system"
  kontrollAnforderung           KontrollAnforderung? @relation("KontrolleEntry")
  kontrollAnforderungAutoMarked KontrollAnforderung? @relation("KontrolleAutoMarkedEntry")
  orgasmusAnforderung           OrgasmusAnforderung? @relation("OrgasmusAnforderungEntry")

  @@index([userId])
  @@index([userId, type, startTime(sort: Desc)])
  // Ein Stempel gilt je Nutzer. Mehrere NULL nebeneinander erlaubt SQLite in einem UNIQUE-Index,
  // Einträge ohne Stempel bleiben also unberührt — es braucht keine Rückfüllung.
  @@unique([userId, clientRequestId])
}

// Keyholder-Aufforderung für einen Orgasmus innerhalb eines Zeitfensters.
// art=ANWEISUNG: Pflicht (Versäumnis -> Strafbuch, Phase 2). art=GELEGENHEIT: Erlaubnis, kein Zwang.
// vorgegebeneArt (optional): erforderliche orgasmusArt-Basis; null = jeder Orgasmus erfüllt.
model OrgasmusAnforderung {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  art            String // "ANWEISUNG" | "GELEGENHEIT"
  message        String?   @map("nachricht")
  beginntAt      DateTime // Fenster-Start
  endsAt         DateTime @map("endetAt") // Fenster-Ende
  vorgegebeneArt String? // erforderliche orgasmusArt-Basis (aus ORGASMUS_ARTEN); null = egal
  oeffnenErlaubt Boolean   @default(false) // während des Fensters darf zum Orgasmus geöffnet werden, ohne Sperre zu brechen / Strafe
  createdAt      DateTime  @default(now())
  fulfilledAt    DateTime? // gesetzt wenn passender ORGASMUS-Eintrag im Fenster erstellt
  entryId        String?   @unique
  entry          Entry?    @relation("OrgasmusAnforderungEntry", fields: [entryId], references: [id], onDelete: SetNull)
  withdrawnAt    DateTime?
  /// Username des Keyholders/Admins, der die Anweisung gestellt hat, bzw. `ai` über den MCP —
  /// dieselbe Spalte und dieselbe Begründung wie `VerschlussAnforderung.createdBy`: eine terminierte
  /// Anweisung stellt der Poller zu, und nur diese Spalte sagt ihm, wer sie angeordnet hat.
  createdBy      String?
  // Zeitversetzte Auslösung: null = sofort. Gesetzt = geplant; bis dahin für den Sub unsichtbar
  // (das Fenster gilt nicht, es erlaubt kein Öffnen und erfüllt sich nicht), Benachrichtigung erst
  // beim Auslösen durch den Poller. Dieselbe Konvention wie bei Kontrolle, Verschluss und Aufgabe
  // (`delayedTrigger.ts`).
  wirksamAb      DateTime?
  benachrichtigtAt DateTime? // wann Mail/Push raus ging (sofort beim Anlegen, oder per Poller)

  @@index([userId, fulfilledAt, withdrawnAt])
  @@index([wirksamAb])
}

// Keyholder-Aufgabe an den Sub: ein Anweisungstext plus 0..n Bedingungen, die bis `holdUntil`
// DURCHGEHEND gelten müssen (z.B. „Wohnung staubsaugen — mit KG verschlossen, Halsband und Knebel,
// bis 15 Uhr"). Ohne Bedingungen ist es eine reine Freitext-Aufgabe mit Frist.
//
// Bewusst eine EIGENE Tabelle statt einer dritten `art` in VerschlussAnforderung: deren Poller
// (kontrollePoller.ts), Rückzug-Pfad und MCP-Sicht lesen die Tabelle OHNE art-Filter und würden eine
// Aufgabe still als Sperrzeit behandeln — zurückziehen, falsch melden, falsch anzeigen. Ausserdem
// trägt dort `dauerH` die Bedeutung „erzeugt beim Einschliessen eine KG-Sperrzeit".
//
// KEIN gespeicherter Fortschritt (kein startedAt/failedAt): der Zustand wird bei jeder Anzeige aus den
// Einträgen abgeleitet (src/lib/tasks.ts). Damit bleibt POST /api/entries unangetastet, vom Keyholder
// nachgetragene Einträge zählen automatisch mit, korrigierte/gelöschte Einträge korrigieren die
// Aufgabe von selbst — und eine nachträglich verschobene `holdUntil` wirkt sofort richtig.
model Task {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  // Bis dahin müssen alle Bedingungen durchgehend gelten. Ohne Bedingungen: Frist zum Erledigen.
  //
  // Im DAUER-MODUS (`holdDurationMin` gesetzt) ist das nicht mehr das wirksame, sondern das
  // SPÄTESTMÖGLICHE Ende (`createdAt` + Kulanz + Dauer) — das wirksame leitet `effectiveHoldUntil`
  // aus dem tatsächlichen Beginn ab. Die Spalte bleibt trotzdem gefüllt und bleibt eine obere
  // Schranke: daran hängen die Indizes, die Sortierung und die Vorauswahl des Pollers, und keine
  // davon darf zu kurz schätzen.
  holdUntil     DateTime
  // Kulanz zum Anlegen ab Erstellung. Wer erst danach beginnt, hat NICHT durchgehend gehalten und
  // erfüllt die Aufgabe nicht — sonst wäre „eine Minute vor Schluss alles anlegen" eine Erfüllung.
  startGraceMin Int      @default(30)
  // DAUER-MODUS: Haltezeit in Minuten, gemessen ab dem tatsächlichen Beginn (= sobald ALLE
  // Bedingungen gleichzeitig anliegen). null = klassischer Modus, `holdUntil` ist das feste Ende.
  //
  // Der Unterschied ist der, den die Keyholderin meint, wenn sie „30 Minuten" einstellt: klassisch
  // geht ihr die Kulanz davon ab (30 gestellt, 15 gehalten, wenn er die Kulanz ausreizt), im
  // Dauer-Modus sind 30 Minuten 30 Minuten — egal wann er anlegt.
  holdDurationMin Int?
  // Müssen die Aufnahmezeiten der Nachweis-Fotos ihrer Reihenfolge folgen? Vorgabe: ja, wie bisher.
  //
  // Manchmal IST die Reihenfolge die Forderung (Verschluss vor Plug vor Rechnungen), manchmal ist sie
  // zufällig („ein Selfie in der Gemüse-, eines in der Blumenabteilung") — dort erzeugte der Zwang ein
  // Vergehen für eine Reihenfolge, die nie jemand verlangt hat. Abgeschaltet entfällt mit der
  // Reihenfolge auch die Sichtung wegen einer FEHLENDEN Aufnahmezeit: die war nur nötig, weil sich
  // die Reihenfolge ohne sie nicht belegen lässt.
  //
  // Nach dem Stellen NICHT mehr änderbar — wie die Nachweise selbst und aus demselben Grund (siehe
  // `mergeTaskPatch`): der Träger fotografiert unter der Regel, die er beim Stellen bekommen hat.
  proofOrderMatters Boolean @default(true)
  // Als Strafe gestellt? Rein informativ — eine Aufgabe ist KEIN StrafeRecord (der kann per Design
  // nur an einem bereits erkannten, vergangenen Vergehen hängen).
  isPunishment  Boolean  @default(false)
  penaltyReason String?
  /// Username des Keyholders/Admins, der die Aufgabe gestellt hat, bzw. `ai` über den MCP —
  /// dieselbe Spalte und dieselbe Begründung wie `KontrollAnforderung.createdBy`: eine TERMINIERTE
  /// Aufgabe stellt der Poller zu, lange nachdem der Mensch den Knopf gedrückt hat, und nur diese
  /// Spalte sagt ihm, wer sie angeordnet hat. `null` = Altbestand bzw. kein Mensch feststellbar →
  /// die Meldung bleibt eine System-Zeile.
  createdBy     String?
  createdAt     DateTime @default(now())
  // Zeitversetzte Auslösung: null = sofort wirksam, wie bisher. Gesetzt = geplant; bis dahin ist die
  // Aufgabe für den Träger unsichtbar, blockiert nichts und zählt nirgends mit.
  //
  // Sie ist ausserdem der NULLPUNKT jeder Zeitrechnung dieser Aufgabe (`taskAnchor` in `tasks.ts`):
  // Kulanzfrist, spätestmögliches Ende im Dauer-Modus und der Kandidaten-Filter der Auswertung
  // ankern auf `wirksamAb ?? createdAt`. Bei der ZUSTELLUNG rückt der Poller sie auf den
  // tatsächlichen Zustell-Zeitpunkt vor (samt `holdUntil`), damit ein verspäteter Tick keine
  // Kulanz verschluckt — siehe `deadlineFromDispatch`.
  wirksamAb        DateTime?
  benachrichtigtAt DateTime? // wann Mail/Push raus ging (sofort beim Anlegen, oder per Poller)
  // Selbstmeldung des Subs. Bei Aufgaben MIT Bedingungen zusätzlich zur Bedingungs-Erfüllung nötig
  // (der Textteil — „ist die Wohnung sauber?" — ist maschinell nicht prüfbar); ohne Bedingungen IST
  // sie die Erfüllung.
  completedAt   DateTime?
  completionNote String?
  withdrawnAt   DateTime?
  // Wann das Ergebnis gemeldet wurde. Nur ein Versand-Stempel, KEIN Zustand: der Zustand einer
  // Aufgabe wird immer aus den Einträgen abgeleitet. Ohne ihn meldete der Poller jede Minute neu.
  resultNotifiedAt DateTime?

  requirements TaskRequirement[]
  proofs       TaskProof[]
  /// Die Urteile, deren Strafe DIESE Aufgabe ist. Eine Liste, kein einzelnes Feld: eine Sammelstrafe
  /// über mehrere Vergehen soll später ohne Migration möglich sein.
  strafeRecords StrafeRecord[]

  @@index([userId, withdrawnAt, completedAt])
  @@index([userId, holdUntil])
  // Für `processDueTasks` im Minuten-Tick. Der sucht OHNE `userId` — die beiden Indizes darüber
  // haben ihn als Präfix und sind damit unbrauchbar, die Abfrage lief als vollständiger Tabellen-Scan
  // plus Sortierung, jede Minute, auf jeder Instanz. `resultNotifiedAt` steht vorn, weil es bei
  // praktisch jeder Altzeile gesetzt ist: der IS-NULL-Bereich bleibt winzig, egal wie gross die
  // Tabelle wird.
  @@index([resultNotifiedAt, holdUntil])
  // Für die Zustellung terminierter Aufgaben im Minuten-Tick
  // (`benachrichtigtAt IS NULL AND wirksamAb <= now`).
  //
  // `benachrichtigtAt` steht VORN — dieselbe Regel wie beim Index darüber: die Zustellung schreibt
  // `wirksamAb` auf den Zustell-Zeitpunkt fort, also liegt es danach bei JEDER ausgelieferten Zeile
  // in der Vergangenheit und fiele in den Suchbereich. Mit der Bereichs-Spalte vorn kann SQLite die
  // zweite nicht mehr zum Suchen nutzen, und der Tick liest jede je terminierte Aufgabe erneut.
  // Andersherum ist der IS-NULL-Bereich winzig, und die Sortierung nach `wirksamAb` bleibt gratis.
  @@index([benachrichtigtAt, wirksamAb])
}

// Eine Bedingung einer Aufgabe. Mehrere je Aufgabe sind der Normalfall („KG verschlossen UND Halsband
// UND Knebel") — sie müssen GLEICHZEITIG gelten, damit die Aufgabe läuft.
model TaskRequirement {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // "WEAR" = Gerät/Kategorie tragen (WEAR_BEGIN..WEAR_END)
  // "KG_LOCKED" = verschlossen sein (VERSCHLUSS..OEFFNEN) — der KG ist bewusst KEINE Wear-Kategorie,
  //   ein WEAR_BEGIN darauf wird abgewiesen (prepareWearEntry → WEAR_DEVICE_KG).
  type String
  // WEAR: geforderte Kategorie („irgendein Plug"). SetNull, damit eine gelöschte Kategorie keine
  // Aufgaben-Historie mitreisst — die Bedingung gilt dann als nicht mehr bewertbar.
  categoryId String?
  category   DeviceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Optional das konkrete Gerät („DIESER Knebel"); enger als categoryId und hat Vorrang.
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sortOrder Int    @default(0)

  @@index([taskId])
  @@index([categoryId])
  @@index([deviceId])
}

/// Ein gefordertes Nachweis-Foto einer Aufgabe (Issue #39).
///
/// EIGENE Tabelle statt eines dritten `TaskRequirement.type` — und das ist keine Kosmetik: eine
/// Bedingung ist ein ZUSTAND, den `evaluateTask` als Intervall schneidet; ein Nachweis ist ein
/// EREIGNIS ohne Intervall. In derselben Tabelle müsste `intersectAll` ihn zum Sonderfall machen —
/// ausgerechnet in der Logik, in der ein Fehler unverdiente Vergehen erzeugt. Dieselbe Begründung,
/// aus der die Aufgabe selbst eigene Tabellen bekam statt einer dritten `art` an
/// `VerschlussAnforderung`.
///
/// Erzeugt bewusst KEINEN `Entry`: ein neuer Eintragstyp liefe durch Paarbildung, Statistik und
/// Zeitstrahl, die alle nichts von Nachweisen wissen. Die Bilddaten hängen deshalb hier.
model TaskProof {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Soll-Reihenfolge: die Aufnahmezeiten müssen ihr folgen (Verschluss vor Plug vor Rechnungen).
  sortOrder Int @default(0)
  /// Was auf dem Bild zu sehen sein muss — Freitext der Keyholderin.
  description String
  /// Verlangt einen handschriftlichen Zufallscode im Bild. Nur damit ist der Nachweis maschinell
  /// entscheidbar; ohne Code geht er zur Sichtung an die Keyholderin.
  requireCode Boolean @default(false)
  /// EIGENE Fälligkeit dieses Nachweises, in Minuten ab dem NULLPUNKT der Aufgabe
  /// (`taskAnchor` = `wirksamAb ?? createdAt`). null = wie bisher: der Nachweis bleibt bis zum Ende
  /// der Aufgabe offen. Damit wird „drei Fotos über den Tag verteilt" ausdrückbar.
  ///
  /// RELATIV und nicht als absoluter Zeitpunkt — aus demselben Grund, aus dem `startGraceMin` eine
  /// Minutenzahl ist: bei der Zustellung einer TERMINIERTEN Aufgabe rückt `dispatchDueTasks` den
  /// Nullpunkt auf den tatsächlichen Zustell-Zeitpunkt vor. Ein gespeichertes Datum müsste dort
  /// mitgeschoben werden — eine zweite Spalte, die still veralten kann. Der Zeitpunkt entsteht
  /// abgeleitet in `proofDeadline()` und ist dort zugleich auf `Task.holdUntil` gedeckelt: die
  /// Nachweis-Frist darf das Ende der Aufgabe nie überschreiten (beim Anlegen abgewiesen).
  dueOffsetMin Int?
  /// Der geforderte Code. Null, wenn `requireCode` false ist.
  code String?

  // ── Einreichung durch den Sub ──
  imageUrl String?
  /// Aufnahmezeit aus den EXIF-Daten. MASSGEBLICH für die Reihenfolge — die Upload-Zeit wäre
  /// wertlos, weil dann alle Fotos am Schluss hochgeladen einfach passten. Fehlt sie, ist die
  /// Reihenfolge nicht prüfbar und der Nachweis geht zur Sichtung.
  imageExifTime DateTime?
  /// Wann eingereicht. Nach `Task.holdUntil` eingereicht zählt NICHT mehr — sonst wäre die Frist
  /// bedeutungslos.
  submittedAt DateTime?
  /// Ergebnis der Code-Erkennung — DIESELBEN drei Felder wie am `Entry` einer Kontrolle, damit
  /// `verifyCode.ts`/`toVerifyFailure()` unverändert darauf passen. Ein blosses `Boolean?` hätte den
  /// Grund weggeworfen, den die Prüfung ohnehin liefert („kein Code im Bild" vs. „falscher Code, es
  /// stand 41287 da") — und die nächste Etappe hätte ein zweites, paralleles Grund-Schema neben
  /// `VerifyReason` gebraucht.
  /// null = nicht geprüft · "ai" = erkannt und passend.
  verifikationStatus String?
  /// `VerifyReason`-Code, wenn NICHT gematcht hat (codeMissing/codeWrong). Sprachneutral.
  verifikationReason String?
  /// Bei `codeWrong`: die abweichend gelesene Nummer.
  verifikationReasonDetected String?
  /// Wann der Keyholderin gemeldet wurde, dass dieser Nachweis VERSPÄTET eingegangen ist und auf ihr
  /// Urteil wartet. null = nie gemeldet. Begründung und Regeln: `notifyLateProof` in
  /// `src/lib/taskProofNotify.ts`.
  lateNotifiedAt DateTime?

  // ── Sichtung durch die Keyholderin ──
  reviewedAt     DateTime?
  reviewAccepted Boolean?
  reviewNote     String?

  @@index([taskId, sortOrder])
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String // VERSCHLUSS | OEFFNUNG_IMMER | OEFFNUNG_VERBOTEN | ORGASMUS | KONTROLLE_FREIWILLIG | KONTROLLE_ANGEFORDERT
  mail      Boolean @default(true)
  push      Boolean @default(true)

  @@unique([userId, eventType])
  @@index([userId])
}

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── OAuth 2.0 Authorization Server ──────────────────────────────────────────
// Enables Claude Mobile / Claude Desktop to authenticate to the MCP server
// via OAuth 2.0 Authorization Code + PKCE instead of a static bearer token.

// Registered OAuth clients (e.g. Claude Desktop, Claude Mobile).
// Dynamic Client Registration (RFC 7591) creates rows here automatically.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String // JSON array of allowed redirect URIs
  createdAt    DateTime @default(now())

  codes         OAuthCode[]
  tokens        OAuthToken[]
  refreshTokens OAuthRefreshToken[]
}

// Short-lived authorization codes (10 min). Exchanged once for an access token.
model OAuthCode {
  id                  String      @id @default(cuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String
  redirectUri         String
  scopes              String // space-separated list, e.g. "read"
  codeChallenge       String // PKCE S256 challenge
  codeChallengeMethod String      @default("S256")
  expiresAt           DateTime
  usedAt              DateTime? // set when exchanged — single-use enforcement
  createdAt           DateTime    @default(now())

  @@index([code])
  @@index([expiresAt])
}

// Short-lived access tokens issued to MCP clients (1 h). Renewed silently via refresh token.
model OAuthToken {
  id        String      @id @default(cuid())
  tokenHash String      @unique // SHA-256 hex of the raw token — never store plaintext
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  scopes    String // space-separated list, e.g. "read"
  expiresAt DateTime // short (1 h) — refresh via OAuthRefreshToken
  createdAt DateTime    @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

// Long-lived refresh tokens (RFC 6749 §6) for silent access-token renewal. Bewusst NICHT-rotierend
// (wiederverwendbar) — vermeidet die Rotation-Race, bei der ein noch-in-Transit alter Token den Grant
// killt. Sicherheit: kurzlebiger Access-Token + Widerruf über /api/oauth/revoke (RFC 7009).
model OAuthRefreshToken {
  id        String      @id @default(cuid())
  tokenHash String      @unique // SHA-256 hex — never store plaintext
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  scopes    String // space-separated list, e.g. "read"
  expiresAt DateTime // long (1 year)
  createdAt DateTime    @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

/// Eine Gewichtsmessung — höchstens EINE je Kalendertag des Subs.
///
/// Bewusst ein eigenes Modell und kein `Entry`-Typ: `Entry` ist vollständig verschluss- und
/// geräteförmig (`deviceId`, `kontrollCode`, `verifikationStatus`, `keyInBox`, `boxImageUrl` …).
/// Ein Gewicht teilt davon nichts und käme mit rund zwanzig dauerhaft leeren Spalten hinein.
model WeightEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt    DateTime
  /// `weightDayKey(measuredAt, user.timezone)` — der Tag in der Zeitzone DES SUBS, als `YYYY-MM-DD`.
  /// Wer um 23:50 Uhr auf der Waage steht, hat an diesem Tag gewogen, nicht an dem, den UTC gerade
  /// zählt. BEWUSST nicht `tzDayKey` aus `utils.ts`: dessen Format ist als opak deklariert und darf
  /// sich ändern — hier hängt der `@@unique` daran, und ein Formatwechsel liesse still zwei Zeilen
  /// je Tag entstehen. Begründung ausführlich bei `weightDayKey`.
  dayKey        String
  /// IMMER metrisch. Gerundet wird beim Tippen (eine Kommastelle), nicht beim Speichern: wer in
  /// Pfund einträgt, tippt 165,4 lbs = 75,0242 kg — auf 75,0 gerundet zeigte die Anzeige ihm 165,3
  /// zurück.
  weightKg      Float
  /// Lag `measuredAt` in einem Wiege-Fenster? Zum Erfassungs-Zeitpunkt festgeschrieben, weil die
  /// Fenster nicht historisiert sind. Ein Wert ausserhalb erfüllt die Meldepflicht trotzdem — er
  /// wird nur im Diagramm abgesetzt und bleibt aus der geglätteten Trendlinie heraus.
  inWindow      Boolean   @default(true)
  /// Foto der Waage. Auf dem SUB-Pfad Pflicht, die Spalte bleibt trotzdem nullbar: die Keyholderin
  /// sitzt beim Nachtragen nicht vor seiner Waage, die KI über den MCP erst recht nicht — und nach
  /// Ablauf der Aufbewahrungsfrist wird die Datei gelöscht, während der Wert bleibt.
  imageUrl      String?
  /// Aufnahmezeit aus den EXIF-Daten. Gegen das Wiege-Fenster geprüft ist sie die schärfste Klinge
  /// gegen ein Foto von gestern — dafür braucht es kein Modell.
  imageExifTime DateTime?
  /// Wann das Foto nach Ablauf der Frist gelöscht wurde. Unterscheidet „hatte nie eines" von
  /// „hatte eines, ist abgelaufen".
  imagePrunedAt DateTime?
  /// Was die Waagen-Erkennung gelesen hat; null = nicht geprüft (kein Foto, kein Vision-Provider,
  /// nicht auswertbar). Getrennt von `weightKg` aus demselben Grund wie `deviceCheckNote` neben
  /// `deviceCheck`: nur so ist sichtbar, ob der Mensch korrigiert hat.
  detectedKg    Float?
  note          String?
  /// "user" | "keyholder" | "agent" — wer die Zeile angelegt hat.
  source        String    @default("user")
  /// Username des Erfassenden (bzw. `ai`), wenn es nicht der Sub selbst war.
  createdById   String?
  /// OCC für Schreibzugriffe über den MCP (`expectedVersion`), wie bei den übrigen MCP-Schreibwegen.
  version       Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([userId, dayKey])
  @@index([userId, measuredAt])
}

/// Eine Änderung der Körpergrösse — append-only, Muster `CleaningRuleChange`.
///
/// **Heute ein Protokoll, keine wirksame Historie.** Jeder BMI im Produkt rechnet mit der aktuellen
/// Grösse am `User`; die Auflösung „welche Grösse galt zu diesem Zeitpunkt" gibt es als `heightAt`,
/// aber sie hat keinen Aufrufer. Die Zeilen halten fest, wer wann welche Zahl eingetragen hat — und
/// sind die Vorarbeit für den Tag, an dem eine BMI-Kurve historisch rechnen soll.
///
/// Bis v5.3.4 fragte das Formular, ob eine neue Zahl eine KORREKTUR sei (dann wurde die jüngste
/// Zeile umgeschrieben) oder echtes Wachstum. Die Rückfrage ist gestrichen: ihr Ausgang war
/// nirgends sichtbar, und bei erwachsenen Menschen ist eine geänderte Körpergrösse fast immer eine
/// korrigierte Angabe. Geschrieben wird jetzt immer eine neue Zeile.
model HeightChange {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm      Int
  effectiveFrom DateTime
  /// Username dessen, der geändert hat (bzw. `ai`). Null bei der Grundzeile.
  changedBy     String?
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
}
